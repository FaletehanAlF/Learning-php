APP_NAME="Kas Management"
APP_URL=http://localhost:8000

# Database MySQL 8.0+ (utama). Kosongkan/abaikan jika pakai SQLite fallback.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kas_db
DB_USERNAME=root
DB_PASSWORD=

# Fallback SQLite lokal (dibuat otomatis via: php artisan migrate)
SQLITE_PATH=storage/data/kas.db

# CORS: asal frontend yang diizinkan (koma-dipisah)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Sanctum-style stateful domains
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173

# Notifikasi pengeluaran besar (Rp)
BIG_EXPENSE_THRESHOLD=1000000
